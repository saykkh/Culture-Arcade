VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# OpenAI API Key를 아래에 입력하세요. (예: OPENAI_API_KEY=sk-proj-...)
OPENAI_API_KEY=your_openai_api_key

# LS전선 Way 오락실 서버 전용 환경변수 (브라우저 번들에 노출되지 않음)
ARCADE_ENV=development
ARCADE_CODE_PEPPER=replace_with_32_byte_random_secret
ARCADE_ADMIN_PASSWORD=replace_with_admin_password
ARCADE_ADMIN_SECRET=replace_with_admin_cookie_secret
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
